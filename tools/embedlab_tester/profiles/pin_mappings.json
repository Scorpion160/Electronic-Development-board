{
  "arduino_uno": {
    "strategy": "tests_par_parties",
    "notes": "Arduino Uno : test complet découpé en plusieurs étapes. J10 sur 5 V.",
    "stages": [
      {
        "name": "Étape 1 — entrées/sorties de base",
        "modules": {
          "leds_rouges": {
            "embedlab": "LED rouge choisie via header LEDs",
            "pin": "4",
            "note": "Tester D2 à D9 une par une avec la même broche si nécessaire."
          },
          "boutons_bp": {
            "embedlab": "BP choisi via header BP",
            "pin": "12",
            "note": "Tester BP1 à BP5 un par un."
          },
          "dip_switch": {
            "embedlab": "Position DIP choisie",
            "pin": "13",
            "note": "Tester les 6 positions une par une."
          },
          "buzzer": {
            "embedlab": "BUZZER",
            "pin": "A3"
          },
          "ldr": {
            "embedlab": "LDR OUT",
            "pin": "A0"
          },
          "potentiometres": {
            "embedlab": "POT1 puis POT2",
            "pin": "A1",
            "note": "Déplacer le fil de POT1 vers POT2 pour le second test."
          },
          "lm35": {
            "embedlab": "LM35 OUT",
            "pin": "A2"
          }
        }
      },
      {
        "name": "Étape 2 — PWM et puissance basse tension",
        "modules": {
          "leds_rgb": {
            "embedlab": "RGB1/RGB2/RGB3 canal choisi",
            "pin": "11",
            "note": "Tester R, G, B un canal à la fois."
          },
          "relais": {
            "embedlab": "Commande RELAIS",
            "pin": "10"
          },
          "mosfet": {
            "embedlab": "Commande MOSFET",
            "pin": "11"
          },
          "pont_h": {
            "embedlab": "Entrées commande pont en H",
            "pin1": "8",
            "pin2": "9"
          }
        }
      },
      {
        "name": "Étape 3 — bus et circuits logiques",
        "modules": {
          "uart_ch340": {
            "embedlab": "USB / J11",
            "pin": "COM"
          },
          "i2c_scan": {
            "embedlab": "J16 PCF8574N",
            "sda": "A4",
            "scl": "A5"
          },
          "pcf8574_gpio": {
            "embedlab": "J16/J15 PCF8574N",
            "sda": "A4",
            "scl": "A5"
          },
          "shift_74hc595": {
            "embedlab": "J14/J13 74HC595N",
            "ds": "5",
            "sh": "6",
            "st": "7"
          },
          "lcd_1602": {
            "embedlab": "LCD 1602 selon configuration de TP",
            "pins": [
              "2",
              "3",
              "4",
              "5",
              "6",
              "7"
            ],
            "note": "Prévoir un câblage LCD dédié ou passer par l'I2C si disponible."
          },
          "seven_segment": {
            "embedlab": "Afficheur 7 segments",
            "pins": [
              "2",
              "3",
              "4",
              "5",
              "6",
              "7",
              "8",
              "9"
            ],
            "note": "Test visuel par segments, idéalement via 74HC595 pour économiser les broches."
          },
          "matrix_8x8": {
            "embedlab": "Matrice LED 8x8",
            "pins": [
              "2",
              "3",
              "4",
              "5",
              "6",
              "7",
              "8",
              "9"
            ],
            "note": "Test par lignes/colonnes, à faire par parties sur Uno."
          },
          "sn74ahct125": {
            "embedlab": "J17/J18 SN74AHCT125",
            "pin": "4",
            "note": "Test de continuité logique : entrée côté microcontrôleur, sortie côté buffer."
          }
        }
      }
    ]
  },
