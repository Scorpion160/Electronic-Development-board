  "arduino_mega": {
    "strategy": "tests_groupes_larges",
    "notes": "Arduino Mega : plus de broches, donc moins de changements de câblage. J10 sur 5 V.",
    "stages": [
      {
        "name": "Étape 1 — test global E/S et capteurs",
        "modules": {
          "leds_rouges": {
            "embedlab": "D2 à D9",
            "pins": [
              "22",
              "23",
              "24",
              "25",
              "26",
              "27",
              "28",
              "29"
            ],
            "pin": "22",
            "note": "Possibilité de câbler plusieurs LEDs simultanément."
          },
          "leds_rgb": {
            "embedlab": "RGB1/RGB2/RGB3",
            "pin": "44",
            "note": "Tester un canal à la fois ou utiliser 44/45/46 pour trois canaux."
